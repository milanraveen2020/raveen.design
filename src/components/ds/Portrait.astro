---
interface Props { src?: string; alt?: string; size?: number; sizeMobile?: number; initials?: string; ring?: boolean; class?: string }
const { src, alt = '', size = 160, sizeMobile, initials, ring = false, class: cls } = Astro.props;
---
<span class:list={['portrait', ring && 'portrait--ring', cls]} style={`--size:${size}px;--size-m:${sizeMobile ?? size}px`}>
  {src ? <img src={src} alt={alt} /> : initials ? <span class="portrait-initials" aria-label={alt || undefined}>{initials}</span> : null}
</span>
<style>
  .portrait { --s: var(--size); position: relative; display: inline-grid; place-items: center; width: var(--s); height: var(--s); border-radius: 50%; overflow: hidden; background: var(--accent-coral); flex-shrink: 0; }
  .portrait--ring { box-shadow: 0 0 0 8px var(--surface); }
  img { width: 100%; height: 100%; object-fit: cover; }
  .portrait-initials { font-family: var(--font-display); font-weight: 500; font-size: calc(var(--s) * 0.32); letter-spacing: -0.03em; color: #fff; }
  @media (max-width: 767px) { .portrait { --s: var(--size-m); } }
</style>

---
interface Props { label?: string; travel?: number }
const { label = 'Scroll', travel = 64 } = Astro.props;
---
<div aria-hidden="true" class="scroll-progress" style={`--travel:${travel}px`}>
  <span class="scroll-progress-label">{label}</span>
  <span class="scroll-progress-track"><span class="scroll-progress-dot" data-progress-dot></span></span>
</div>
<style>
  .scroll-progress { position: fixed; left: 28px; bottom: 32px; z-index: 30; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .scroll-progress-label { writing-mode: vertical-rl; transform: rotate(180deg); font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-900); }
  .scroll-progress-track { position: relative; width: 2px; height: calc(var(--travel) + 8px); background: var(--line); border-radius: 2px; }
  .scroll-progress-dot { position: absolute; left: -3px; top: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--ink-900); transform: translate3d(0, calc(var(--p, 0) * var(--travel)), 0); }
  @media (max-width: 991px) { .scroll-progress { display: none; } }
</style>
<script>
  const dot = document.querySelector<HTMLElement>('[data-progress-dot]');
  let raf = 0;
  const read = () => {
    raf = 0;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    dot?.style.setProperty('--p', String(max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0));
  };
  window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(read); }, { passive: true });
  read();
</script>

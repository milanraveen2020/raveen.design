---
// Lucide icon, inlined at build time from lucide-static (1.75 stroke, currentColor).
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { name: string; size?: number; strokeWidth?: number; label?: string; class?: string; style?: string }
const { name, size = 20, strokeWidth = 1.75, label, class: cls, style } = Astro.props;

const cache: Map<string, string> = ((globalThis as any).__lucideCache ??= new Map());
let raw = cache.get(name);
if (raw === undefined) {
  try { raw = readFileSync(join(process.cwd(), 'node_modules/lucide-static/icons', name + '.svg'), 'utf8'); }
  catch { raw = ''; console.warn('[Icon] missing lucide icon: ' + name); }
  cache.set(name, raw);
}
const svg = raw.replace(/<!--[\s\S]*?-->/g, '').replace(/width="24"/, 'width="' + size + '"').replace(/height="24"/, 'height="' + size + '"').replace(/stroke-width="2"/, 'stroke-width="' + strokeWidth + '"');
---
<span class:list={['icon', cls]} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} style={`width:${size}px;height:${size}px;${style ?? ''}`} set:html={svg} />
<style>
  .icon { display: inline-flex; flex-shrink: 0; line-height: 0; color: currentColor; }
</style>

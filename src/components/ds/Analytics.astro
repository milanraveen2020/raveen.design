---
// Google Analytics 4 with Consent Mode v2. Renders nothing unless PUBLIC_GA_MEASUREMENT_ID is set.
// Before a choice, analytics cookies are denied in the EEA, UK and Switzerland (GA sends cookieless pings there)
// and allowed elsewhere. The banner records the visitor's choice; "Cookie settings" in the footer reopens it.
import { PUBLIC_GA_MEASUREMENT_ID as id } from 'astro:env/client';
---
{id ? (
  <>
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      var ads = { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' };
      gtag('consent', 'default', Object.assign({ analytics_storage: 'denied', wait_for_update: 500, region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH'] }, ads));
      gtag('consent', 'default', Object.assign({ analytics_storage: 'granted' }, ads));
      var choice = null;
      try { choice = localStorage.getItem('consent'); } catch (e) {}
      if (choice) gtag('consent', 'update', { analytics_storage: choice === 'granted' ? 'granted' : 'denied' });
      gtag('js', new Date());
      gtag('config', id);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
      document.head.appendChild(s);
    </script>
    <div class="consent" role="region" aria-label="Cookie choice" hidden data-consent>
      <p>I use Google Analytics cookies to see which pages are useful. Nothing is used for ads.</p>
      <div class="consent-actions">
        <button type="button" class="consent-btn" data-consent-choice="denied">Decline</button>
        <button type="button" class="consent-btn consent-btn--accept" data-consent-choice="granted">Accept</button>
      </div>
    </div>
  </>
) : null}

<script>
  const banner = document.querySelector<HTMLElement>('[data-consent]');
  if (banner) {
    let stored: string | null = null;
    try { stored = localStorage.getItem('consent'); } catch {}
    if (!stored) banner.hidden = false;
    banner.querySelectorAll<HTMLButtonElement>('[data-consent-choice]').forEach((btn) => btn.addEventListener('click', () => {
      const value = btn.dataset.consentChoice as 'granted' | 'denied';
      try { localStorage.setItem('consent', value); } catch {}
      window.gtag?.('consent', 'update', { analytics_storage: value });
      banner.hidden = true;
    }));
    document.querySelectorAll<HTMLElement>('[data-consent-open]').forEach((el) => {
      el.hidden = false;
      el.addEventListener('click', () => { banner.hidden = false; banner.querySelector<HTMLButtonElement>('button')?.focus(); });
    });
  }
</script>

<style>
  .consent { position: fixed; z-index: 60; left: max(28px, env(safe-area-inset-left)); bottom: max(28px, env(safe-area-inset-bottom)); width: min(400px, calc(100% - 56px));
    background: var(--surface); border-radius: var(--radius-md); box-shadow: var(--shadow-float); padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-700); }
  .consent-actions { display: flex; gap: 10px; justify-content: flex-end; }
  .consent-btn { height: 40px; padding: 0 18px; border-radius: var(--radius-pill); border: 1px solid var(--ink-900); background: transparent; color: var(--ink-900);
    font: 600 14px var(--font-body); cursor: pointer; transition: background 240ms ease-out, color 240ms ease-out; }
  .consent-btn:hover { background: #F3F4F8; }
  .consent-btn--accept { background: var(--ink-900); color: #fff; }
  .consent-btn--accept:hover { background: #2A2D45; }
  @media (max-width: 479px) {
    .consent { left: 16px; right: 16px; bottom: max(16px, env(safe-area-inset-bottom)); width: auto; }
    .consent-btn { flex: 1; }
  }
</style>

---
// One shared lightbox per page. Any <MediaFrame zoomable> opens it.
import Icon from './Icon.astro';
---
<div class="lightbox" role="dialog" aria-modal="true" aria-label="Image" hidden data-lightbox>
  <button type="button" aria-label="Close" class="lightbox-close" data-lightbox-close><Icon name="x" size={20} /></button>
  <figure class="lightbox-body">
    <div class="lightbox-frame" data-lightbox-frame></div>
    <figcaption data-lightbox-caption></figcaption>
  </figure>
</div>
<style>
  .lightbox { position: fixed; inset: 0; z-index: 80; background: rgba(23,25,43,.88); display: grid; place-items: center; padding: clamp(16px, 5vw, 72px); animation: reveal-up 360ms var(--ease-out); }
  .lightbox[hidden] { display: none; }
  .lightbox-close { position: absolute; top: 24px; right: 24px; width: 48px; height: 48px; border-radius: 50%; border: none; background: var(--surface); color: var(--ink-900); display: grid; place-items: center; cursor: pointer; }
  .lightbox-body { margin: 0; display: flex; flex-direction: column; align-items: center; max-width: min(100%, 1100px); }
  /* The whole image, at its own shape: wide desktop shots fill the width, tall phone shots fit the height. */
  .lightbox-frame { line-height: 0; }
  .lightbox-frame :global(img) { display: block; max-width: 100%; max-height: calc(100dvh - 2 * clamp(16px, 5vw, 72px) - 40px); width: auto; height: auto; object-fit: contain; border-radius: var(--radius-lg); background: var(--canvas-cream); }
  figcaption { margin: 14px 0 0; align-self: flex-start; color: #fff; font-size: 14px; font-weight: 500; }
</style>
<script>
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const frame = box?.querySelector<HTMLElement>('[data-lightbox-frame]');
  const cap = box?.querySelector<HTMLElement>('[data-lightbox-caption]');
  const closeBtn = box?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  let opener: HTMLElement | null = null;
  const close = () => { if (!box || box.hidden) return; box.hidden = true; frame?.replaceChildren(); document.documentElement.style.overflow = ''; opener?.focus(); };
  document.querySelectorAll<HTMLElement>('[data-lightbox-src]').forEach((el) => {
    el.addEventListener('click', () => {
      if (!box || !frame || !cap) return;
      opener = el;
      // The <img> is created on open, so the page never carries an image without a src.
      const img = new Image();
      img.src = el.dataset.lightboxSrc || '';
      img.alt = el.dataset.lightboxAlt || '';
      frame.replaceChildren(img);
      cap.textContent = el.dataset.lightboxTitle || '';
      box.setAttribute('aria-label', el.dataset.lightboxTitle || 'Image');
      box.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      closeBtn?.focus();
    });
  });
  box?.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.lightbox-body')) close(); });
  document.addEventListener('keydown', (e) => {
    if (!box || box.hidden) return;
    if (e.key === 'Escape') close();
    // The close button is the only control, so Tab keeps focus on it (aria-modal dialog).
    if (e.key === 'Tab') { e.preventDefault(); closeBtn?.focus(); }
  });
</script>

---
import Icon from './Icon.astro';
interface Props { href: string }
const { href } = Astro.props;
---
<a href={href} aria-label="Send an email" class="mail-shortcut">
  <span class="mail-slot mail-slot--a"><Icon name="mail" size={20} /></span>
  <span class="mail-slot mail-slot--b"><Icon name="arrow-up-right" size={20} /></span>
</a>
<style>
  .mail-shortcut { position: fixed; right: max(28px, env(safe-area-inset-right)); bottom: max(28px, env(safe-area-inset-bottom)); z-index: 40; width: 52px; height: 52px; border-radius: 50%; overflow: hidden; display: inline-block;
    background: var(--surface); box-shadow: var(--shadow-float); color: var(--ink-900); transition: color 320ms var(--ease-out); }
  .mail-slot { position: absolute; inset: 0; display: grid; place-items: center; transition: transform 320ms var(--ease-out); }
  .mail-slot--b { transform: translateY(100%); }
  .mail-shortcut:hover, .mail-shortcut:focus-visible { color: var(--accent-coral); }
  .mail-shortcut:hover .mail-slot--a, .mail-shortcut:focus-visible .mail-slot--a { transform: translateY(-100%); }
  .mail-shortcut:hover .mail-slot--b, .mail-shortcut:focus-visible .mail-slot--b { transform: translateY(0); }
</style>

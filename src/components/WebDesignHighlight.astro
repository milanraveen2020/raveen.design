---
// Home band for the main line of work: the end-to-end process.
import Section from './Section.astro';
import SectionHead from './SectionHead.astro';
import Reveal from './Reveal.astro';
import ProcessSteps from './ProcessSteps.astro';
import { WEB_DESIGN } from '../data/site';
---
<Section bg="cream" id="web-design" top={140} bottom={160}>
  <div class="container">
    <div class="wd-head">
      <SectionHead label={WEB_DESIGN.label} title={WEB_DESIGN.title} />
      <Reveal delay={80}><p class="ds-body-lg muted wd-lead">{WEB_DESIGN.lead}</p></Reveal>
    </div>

    <ProcessSteps class="wd-steps" />
  </div>
</Section>

<style>
  .wd-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 64px; align-items: end; }
  .wd-lead { max-width: 52ch; }
  .wd-head + :global(.wd-steps) { margin-top: 96px; }

  @media (max-width: 991px) {
    .wd-head { grid-template-columns: 1fr; gap: 24px; }
    .wd-head + :global(.wd-steps) { margin-top: 48px; }
  }
</style>

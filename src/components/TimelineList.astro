---
interface Item { start: string; end: string; role: string; org: string; body: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ul class="timeline">
  {items.map((it) => (
    <li>
      <span class="label">{it.start}{it.end ? ' — ' + it.end : ' —'}</span>
      <div class="timeline-body">
        <h3>{it.role}</h3>
        <span class="timeline-org">{it.org}</span>
        <p>{it.body}</p>
      </div>
    </li>
  ))}
</ul>
<style>
  .timeline { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 120px minmax(0,1fr); gap: 24px; padding: 28px 0; border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  .label { padding-top: 6px; }
  .timeline-body { display: flex; flex-direction: column; gap: 6px; }
  h3 { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 22px; line-height: 1.25; letter-spacing: -0.015em; }
  .timeline-org { font-size: 15px; font-weight: 500; color: var(--ink-700); }
  p { margin: 8px 0 0; color: var(--ink-700); max-width: 60ch; }
  @media (max-width: 767px) { li { grid-template-columns: 1fr; gap: 8px; } }
</style>

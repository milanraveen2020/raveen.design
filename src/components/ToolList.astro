---
// Tools and technology as logo pills (brand marks from data/logos.ts; card icon for anything without one).
import Tag from './ds/Tag.astro';
import Icon from './ds/Icon.astro';
import { WEB_DESIGN } from '../data/site';
import { TECH_LOGOS } from '../data/logos';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={['tools', cls]}>
  <span class="label">Tools and technology</span>
  <ul class="tools-list">
    {WEB_DESIGN.stack.map((t) => {
      const logo = TECH_LOGOS[t];
      return (
        <li><Tag shape="chip" tone="surface" class="tool">
          {logo
            ? <svg class="tool-logo" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style={`color:${logo.color}`}><path d={logo.path} fill="currentColor" /></svg>
            : <Icon name="credit-card" size={18} class="tool-logo" />}
          {t}
        </Tag></li>
      );
    })}
  </ul>
</div>
<style>
  .tools { display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .tools-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 920px; }
  .tools-list :global(.tool) { gap: 10px; padding: 10px 18px 10px 14px; }
  .tools-list :global(.tool-logo) { flex-shrink: 0; }
</style>

---
// Designer / coder split-face hero (after adhamdannaway.com).
// One custom property, --d (-1 … 1), drives everything: the seam between the two portraits,
// a slight parallax shift, and the fade of the opposite side's copy and background.
// Pointer left of centre → d > 0 → the painted "designer" side widens; right → the "coder" side widens.
import { Image } from 'astro:assets';
import photoLeft from '../images/photo-left.png';
import photoRight from '../images/photo-right.png';

const sizes = '(max-width: 991px) min(92vw, 560px), 980px';
const code = [
  { t: '<header class="hero">', x: 4, y: 0 },
  { t: '.card { border-radius: 24px; }', x: 0, y: 1 },
  { t: 'const [open, setOpen] = useState();', x: 10, y: 2 },
  { t: 'Astro  Next.js  Sanity', x: 18, y: 3, big: true },
  { t: 'color: #17192B;', x: 6, y: 4.4, big: true },
  { t: '</header>', x: 22, y: 5.8 },
];
---
<section class="split-hero" data-split-hero style="--d:0">
  <h1 class="sr-only">Raveen Nanayakkara — web designer and developer, UI/UX engineer</h1>

  <div class="split-copy split-copy--designer">
    <div class="split-copy-in enter" style="--delay:700ms">
      <div class="split-word">designer</div>
      <p>Web designer with ten years of UI/UX engineering, shaping brands and websites people enjoy using.</p>
    </div>
  </div>
  <div class="split-copy split-copy--coder">
    <div class="split-copy-in enter" style="--delay:700ms">
      <div class="split-word"><span aria-hidden="true">&lt;</span>coder<span aria-hidden="true">&gt;</span></div>
      <p>Developer building fast websites and online stores with Astro, Next.js and a headless CMS.</p>
    </div>
  </div>

  <div class="split-stage" data-split-stage>
    <!-- Designer backdrop: loose paint strokes -->
    <svg class="split-bg split-bg--designer" viewBox="0 0 400 300" aria-hidden="true">
      <defs>
        <filter id="split-brush" x="-10%" y="-10%" width="120%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9 0.05" numOctaves="2" seed="4" />
          <feDisplacementMap in="SourceGraphic" scale="14" />
        </filter>
      </defs>
      <g filter="url(#split-brush)" fill="none" stroke-linecap="round">
        <path d="M40 250 C 120 200, 220 190, 330 150" stroke="#F6B6A8" stroke-width="34" opacity=".75" />
        <path d="M90 270 C 150 210, 200 120, 230 40" stroke="#F2C14E" stroke-width="22" opacity=".8" />
        <path d="M150 280 C 190 220, 250 170, 300 90" stroke="#7FB7BE" stroke-width="26" opacity=".7" />
        <path d="M20 210 C 90 190, 160 200, 260 230" stroke="var(--accent-coral)" stroke-width="10" opacity=".55" />
      </g>
    </svg>
    <!-- Coder backdrop: faint code -->
    <div class="split-bg split-bg--coder" aria-hidden="true">
      {code.map((l) => <span class:list={['split-code', l.big && 'is-big']} style={`--x:${l.x}%;--y:${l.y}`}>{l.t}</span>)}
    </div>

    <div class="split-face-wrap split-face-wrap--designer enter" style="--delay:120ms;--from:translateX(-6%)">
      <div class="split-face split-face--designer">
        <Image src={photoLeft} alt="Painted portrait of Raveen Nanayakkara" widths={[480, 720, 1000]} sizes={sizes} format="webp" loading="eager" fetchpriority="high" />
      </div>
    </div>
    <div class="split-face-wrap split-face-wrap--coder enter" style="--delay:120ms;--from:translateX(6%)">
      <div class="split-face split-face--coder">
        <Image src={photoRight} alt="" widths={[480, 720, 1000]} sizes={sizes} format="webp" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
</section>

<style>
  .split-hero {
    --seam: calc(50% + 25% * var(--d));
    --shift: calc(5% * var(--d));
    --designer-o: clamp(0, calc(1 + var(--d)), 1);
    --coder-o: clamp(0, calc(1 - var(--d)), 1);
    position: relative; overflow: hidden; background: var(--canvas-blush);
    min-height: min(100svh, 980px); display: flex; align-items: flex-end; justify-content: center; padding-top: 92px;
  }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); margin: -1px; padding: 0; white-space: nowrap; }

  /* Stage: the two full portraits sit on top of each other; each is clipped to its side of the seam */
  .split-stage { position: relative; width: min(100%, 980px, calc((100svh - 120px) * 1.13)); aspect-ratio: 1000 / 885; }
  .split-face-wrap { position: absolute; inset: 0; z-index: 2; }
  .split-face { position: absolute; inset: 0; transform: translateX(var(--shift)); }
  .split-face--designer { clip-path: inset(0 calc(100% - var(--seam)) 0 0); }
  .split-face--coder { clip-path: inset(0 0 0 var(--seam)); }
  .split-face :global(img) { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; user-select: none; -webkit-user-drag: none; }

  .split-bg { position: absolute; z-index: 1; pointer-events: none; }
  .split-bg--designer { left: -14%; bottom: 0; width: 48%; height: auto; opacity: var(--designer-o); transform: translateX(calc(2.5% * var(--d))); }
  .split-bg--coder { right: -16%; bottom: 6%; width: 52%; height: 34%; opacity: var(--coder-o); transform: translateX(calc(2.5% * var(--d))); }
  .split-code { position: absolute; left: var(--x); top: calc(var(--y) * 15%); font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-size: clamp(11px, 1.15vw, 16px); color: var(--ink-500); opacity: .55; white-space: nowrap; }
  .split-code.is-big { font-size: clamp(16px, 2vw, 28px); opacity: .45; }

  /* Copy either side of the face */
  .split-copy { position: absolute; z-index: 3; top: 40%; width: min(30vw, 360px); }
  .split-copy-in { display: flex; flex-direction: column; gap: 14px; }
  .split-copy--designer { left: max(24px, calc((100% - var(--container)) / 2)); opacity: var(--designer-o); }
  .split-copy--coder { right: max(24px, calc((100% - var(--container)) / 2)); opacity: var(--coder-o); }
  .split-word { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1; letter-spacing: -0.045em; color: var(--ink-900); }
  .split-copy p { font-size: var(--size-body-lg); line-height: 1.5; color: var(--ink-700); max-width: 26ch; }
  .split-copy--designer .split-word { color: var(--ink-900); }
  .split-copy--coder .split-word span { color: var(--accent-coral); font-weight: 500; }

  /* Tablet / phone: no pointer interaction, copy sits above the face as two columns */
  @media (max-width: 991px) {
    .split-hero { --d: 0 !important; display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; align-items: start; min-height: 0; padding: 112px 24px 0; }
    .split-copy { position: relative; top: auto; left: auto; right: auto; width: auto; }
    .split-copy-in { gap: 8px; }
    .split-copy--coder { text-align: right; }
    .split-copy--coder .split-copy-in { align-items: flex-end; }
    .split-copy p { font-size: 15px; max-width: 24ch; }
    .split-word { font-size: clamp(2.25rem, 9vw, 4rem); }
    .split-stage { grid-column: 1 / -1; justify-self: center; width: min(100%, 560px); margin-top: 24px; }
  }
  @media (max-width: 767px) { .split-bg--coder { display: none; } }
  @media (max-width: 479px) {
    .split-hero { padding-inline: 16px; column-gap: 12px; }
    .split-copy p { font-size: 13px; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-split-hero]');
  const stage = hero?.querySelector<HTMLElement>('[data-split-stage]');
  const interactive = window.matchMedia('(min-width: 992px) and (hover: hover) and (pointer: fine)');
  const instant = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && stage) {
    let target = 0;
    let d = 0;
    let raf = 0;
    const apply = () => hero.style.setProperty('--d', d.toFixed(4));
    // Ease towards the pointer (the reference's "zeno" damping), stop once settled.
    const tick = () => {
      d += (target - d) * (instant.matches ? 1 : 0.09);
      if (Math.abs(target - d) < 0.001) d = target;
      apply();
      raf = d === target ? 0 : requestAnimationFrame(tick);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
    hero.addEventListener('pointermove', (e) => {
      if (!interactive.matches || e.pointerType !== 'mouse') return;
      const r = stage.getBoundingClientRect();
      target = Math.max(-1, Math.min(1, (r.left + r.width / 2 - e.clientX) / (r.width / 2)));
      kick();
    });
    hero.addEventListener('pointerleave', () => { target = 0; kick(); });
    interactive.addEventListener('change', () => { target = 0; d = 0; apply(); });
  }
</script>

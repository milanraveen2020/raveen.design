---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ds/Button.astro';
import FormStatus from '../components/ds/FormStatus.astro';
import Icon from '../components/ds/Icon.astro';
import Tag from '../components/ds/Tag.astro';
import TextField from '../components/ds/TextField.astro';
import { INQUIRY, PROFILE, DESCRIPTIONS, TITLES } from '../data/site';
import { LIMITS } from '../lib/contact';

const links = [
  { label: 'LinkedIn', icon: 'linkedin', href: PROFILE.linkedin },
  { label: 'Behance', icon: 'palette', href: PROFILE.behance },
  { label: 'Fiverr — design-to-frontend', icon: 'briefcase-business', href: PROFILE.fiverrBootstrap },
  { label: 'Fiverr — Next.js websites', icon: 'briefcase-business', href: PROFILE.fiverrNext },
];
const year = new Date().getFullYear();
import { page, breadcrumbs, ids } from '../data/schema';
const site = Astro.site!;
---
<BaseLayout title={TITLES['/contact']} description={DESCRIPTIONS['/contact']} schema={[page(site, '/contact', 'ContactPage', TITLES['/contact'], DESCRIPTIONS['/contact'], { mainEntity: { '@id': ids(site).business } }), breadcrumbs(site, [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }])]} footer="none">
  <section id="contact" class="contact">
    <div class="container">
      <h1 class="ds-display-hero enter" style="--delay:140ms;--from:translateY(5%)">Let’s work together.</h1>
      <p class="ds-body-lg muted contact-intro enter" style="--delay:300ms">Need a new website, an online store, or a brand to go with them? Tell me a little about your business and what you want to achieve, and I’ll take it from there.</p>

      <div class="contact-grid enter" style="--delay:420ms">
        <div>
          <FormStatus status="success" title="Thanks for reaching out." hidden data-form-sent id="sent">Your message has been submitted. I’ll get back to you when I can.</FormStatus>
          <!-- Validates in the browser, then POSTs to /api/contact (src/pages/api/contact.ts), which emails it via Resend. -->
          <form novalidate class="contact-form" data-contact-form action="/api/contact" method="post">
            <FormStatus status="error" class="span-2 form-error" hidden data-form-error id="send-error">Your message couldn’t be sent. Please try again or contact me by email.</FormStatus>
            <!-- Honeypot: hidden from people and screen readers; bots that fill it are ignored by the API. -->
            <div class="hp" aria-hidden="true"><label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
            <TextField label="Name" name="name" required maxlength={LIMITS.name} autocomplete="name" />
            <TextField label="Email" name="email" type="email" required maxlength={LIMITS.email} autocomplete="email" />
            <!-- Native radio buttons styled as chips: arrow keys, screen readers and no-JS posting all work out of the box. -->
            <fieldset class="span-2 types" data-field="type">
              <legend>Project Type<span aria-hidden="true" class="req"> *</span><span data-err-text></span></legend>
              <div class="chips">
                {INQUIRY.map((t) => (
                  <label class="chip">
                    <input type="radio" name="type" value={t} required class="chip-input" />
                    <Tag shape="chip" tone="surface" class="chip-tag">{t}</Tag>
                  </label>
                ))}
              </div>
            </fieldset>
            <TextField label="Project Summary" name="summary" multiline required maxlength={LIMITS.summary} class="span-2" />
            <TextField label="Website or Reference URL (optional)" name="url" type="url" maxlength={LIMITS.url} autocomplete="url" class="span-2" />
            <div class="span-2" style="margin-top:8px"><Button type="submit" icon="send" class="submit" data-submit>Send message</Button></div>
          </form>
        </div>

        <aside class="contact-aside">
          <div><span class="label">Email</span><a href={'mailto:' + PROFILE.email} class="contact-email">{PROFILE.email}</a></div>
          <div><span class="label">Elsewhere</span>
            <div class="contact-links">
              {links.map((s) => <a href={s.href} target="_blank" rel="noreferrer" class="site-ext contact-link"><Icon name={s.icon} size={20} />{s.label}</a>)}
            </div>
          </div>
          <div><span class="label">I can help with</span><p class="muted" style="margin-top:10px">{INQUIRY.join(' · ')}</p></div>
        </aside>
      </div>

      <div class="contact-legal"><span>© {year} Raveen Nanayakkara. All rights reserved.</span><span>Thoughtful design. Practical development.</span></div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { background: var(--canvas-blush); min-height: 100vh; padding: 190px 0 64px; }
  h1 { margin: 0; max-width: 9ch; }
  .contact-intro { margin-top: 28px; max-width: 52ch; }
  .contact-grid { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); gap: 96px; margin-top: 96px; align-items: start; }
  .contact-form { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 32px; }
  .contact-form[hidden] { display: none; }
  /* Without JavaScript the API redirects to #sent or #send-error; :target shows the right message. */
  .contact-grid :global(.form-status:target) { display: flex; }
  .contact-grid:has(#sent:target) .contact-form { display: none; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .contact-form :global(.span-2) { grid-column: 1 / -1; }
  .contact-form :global(.form-error) { margin-bottom: 16px; }
  .types { border: 0; margin: 12px 0 20px; padding: 0; }
  /* Same style as the text field labels (TextField.astro) */
  legend { padding: 0; margin-bottom: 14px; font-size: 13px; font-weight: 600; color: var(--ink-700); }
  .req { color: var(--accent-coral-text); }
  .types.has-error legend { color: var(--danger); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; cursor: pointer; border-radius: 999px; min-height: 44px; display: inline-flex; align-items: center; }
  .chip-input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .chip-input:checked + :global(.chip-tag) { --bg: var(--accent-coral-strong); --fg: #fff; }
  .chip-input:focus-visible + :global(.chip-tag) { outline: 2px solid var(--ink-900); outline-offset: 3px; }
  .contact-aside { display: flex; flex-direction: column; gap: 40px; }
  .contact-email { display: inline-block; margin-top: 10px; font-family: var(--font-display); font-size: 24px; font-weight: 500; letter-spacing: -0.015em; color: var(--ink-900); text-decoration: none; word-break: break-all; }
  .contact-email:hover { color: var(--accent-coral-text); }
  .contact-links { display: flex; flex-direction: column; gap: 2px; margin-top: 10px; }
  .contact-link { gap: 12px; font-size: 17px; }
  .contact-legal { margin-top: 160px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 13px; color: var(--ink-500); }
  @media (max-width: 991px) { .contact-grid { grid-template-columns: 1fr; gap: 64px; } }
  @media (max-width: 767px) {
    .contact { padding: 128px 0 48px; }
    .contact-grid { margin-top: 56px; }
    .contact-form { grid-template-columns: 1fr; }
    .contact-form :global(.submit) { display: flex; width: 100%; }
    .contact-legal { margin-top: 96px; }
  }
  @media (max-width: 479px) { .contact-email { font-size: 20px; } }
</style>

<script>
  import { clean, validate } from '../lib/contact';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const sent = document.querySelector<HTMLElement>('[data-form-sent]');
  const failed = document.querySelector<HTMLElement>('[data-form-error]');
  const submit = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const radios = Array.from(form?.querySelectorAll<HTMLInputElement>('input[name="type"]') ?? []);

  const setError = (name: string, msg?: string) => {
    const field = form?.querySelector<HTMLElement>(`[data-field="${name}"]`);
    if (!field) return;
    field.classList.toggle('has-error', !!msg);
    const text = field.querySelector<HTMLElement>('[data-err-text]');
    const input = field.querySelector<HTMLElement>('input:not([type="hidden"]), textarea');
    if (name === 'type') { if (text) text.textContent = msg ? ' — ' + msg : ''; return; }
    const err = field.querySelector<HTMLElement>('.field-err');
    if (err) err.hidden = !msg;
    if (text) text.textContent = msg ?? '';
    if (input) {
      if (msg) { input.setAttribute('aria-invalid', 'true'); input.setAttribute('aria-describedby', err?.id ?? ''); }
      else { input.removeAttribute('aria-invalid'); input.removeAttribute('aria-describedby'); }
    }
  };

  radios.forEach((r) => r.addEventListener('change', () => setError('type')));

  const resetSubmit = () => {
    if (submit) { submit.disabled = false; submit.removeAttribute('aria-busy'); submit.querySelector('.btn-label')!.textContent = 'Send message'; }
  };
  // Move focus to the first field with an error (for the project type, the selected or first option).
  const focusFirstError = () => {
    const field = form?.querySelector<HTMLElement>('.has-error');
    const target = field?.dataset.field === 'type'
      ? (radios.find((r) => r.checked) ?? radios[0])
      : field?.querySelector<HTMLElement>('input:not([type="hidden"]), textarea');
    target?.focus();
  };

  // Without JavaScript the form posts normally and the API redirects back here with ?sent=1 or ?error=1.
  const result = new URLSearchParams(location.search);
  if (result.has('sent') && form && sent) { form.hidden = true; sent.hidden = false; sent.focus(); }
  else if (result.has('error') && failed) { failed.hidden = false; failed.focus(); }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errors = validate(clean((k) => new FormData(form).get(k))) as Record<string, string>;
    ['name', 'email', 'type', 'summary'].forEach((k) => setError(k, errors[k]));
    // Field errors explain themselves; the banner is only for a failed send.
    if (failed) failed.hidden = true;
    if (Object.keys(errors).length) { focusFirstError(); return; }

    if (submit) { submit.disabled = true; submit.setAttribute('aria-busy', 'true'); submit.querySelector('.btn-label')!.textContent = 'Sending…'; }
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!res.ok) {
        // The API re-checks the fields; show its messages next to the inputs if it rejects any.
        const body = await res.json().catch(() => ({}));
        if (body.errors) {
          Object.entries(body.errors as Record<string, string>).forEach(([k, msg]) => setError(k, msg));
          resetSubmit();
          focusFirstError();
          return;
        }
        throw new Error(String(res.status));
      }
      form.hidden = true;
      if (sent) { sent.hidden = false; sent.focus(); }
    } catch {
      if (failed) { failed.hidden = false; failed.focus(); }
      resetSubmit();
    }
  });
</script>

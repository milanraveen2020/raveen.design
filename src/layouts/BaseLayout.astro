---
import '../styles/global.css';
import SiteHeader from '../components/ds/SiteHeader.astro';
import SiteFooter from '../components/ds/SiteFooter.astro';
import ChatShortcut from '../components/ds/ChatShortcut.astro';
import ScrollProgress from '../components/ds/ScrollProgress.astro';
import Button from '../components/ds/Button.astro';
import Analytics from '../components/ds/Analytics.astro';
import { PUBLIC_GA_MEASUREMENT_ID, PUBLIC_GOOGLE_SITE_VERIFICATION, PUBLIC_BING_SITE_VERIFICATION } from 'astro:env/client';
import { NAV, PROFILE, SOCIALS } from '../data/site';
import { baseGraph } from '../data/schema';

interface Props {
  title: string;
  description?: string;
  /** Footer copy variant. 'none' hides the footer + mail shortcut (the contact page has its own). */
  footer?: 'home' | 'about' | 'default' | 'none';
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
  /** Social share image: a path under /public (e.g. /images/websites/x.jpg). Defaults to the branded card. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** 'article' for case studies, 'website' for everything else. */
  type?: 'website' | 'article';
  /** Page-specific schema.org nodes, added to the site-wide graph (WebSite, Person, ProfessionalService). */
  schema?: Record<string, unknown>[];
}
const {
  title,
  description = 'Web designer and developer with 10 years of UI/UX engineering. Fast Astro and Next.js websites, e-commerce, branding, hosting and SEO for businesses.',
  footer = 'default',
  noindex = false,
  image = '/og-share.jpg',
  imageAlt = 'Split portrait of Raveen Nanayakkara, half painted and half photographed, between the words designer and coder',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  schema = [],
} = Astro.props;
const bare = footer === 'none';
const headline = footer === 'home' ? 'Have a project in mind?' : footer === 'about' ? 'Let’s create something useful.' : 'Let’s work together.';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = path.startsWith('/work') ? '/work' : path;
const year = new Date().getFullYear();
// Canonical URL without a trailing slash (trailingSlash: 'never'), on the production domain.
const canonical = noindex || !Astro.site ? undefined : new URL(path, Astro.site).href;
const imageUrl = new URL(image, Astro.site ?? Astro.url).href;
const jsonLd = Astro.site && !noindex ? JSON.stringify({ '@context': 'https://schema.org', '@graph': [...baseGraph(Astro.site), ...schema] }).replace(/</g, '\\u003c') : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <!-- Social cards (Open Graph for LinkedIn, Facebook, WhatsApp; Twitter/X) -->
    <meta property="og:site_name" content="Raveen.design" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="author" content="Raveen Nanayakkara" />
    {PUBLIC_GOOGLE_SITE_VERIFICATION ? <meta name="google-site-verification" content={PUBLIC_GOOGLE_SITE_VERIFICATION} /> : null}
    {PUBLIC_BING_SITE_VERIFICATION ? <meta name="msvalidate.01" content={PUBLIC_BING_SITE_VERIFICATION} /> : null}
    {jsonLd ? <script type="application/ld+json" set:html={jsonLd} /> : null}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Sora:wght@400;500;600&display=swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader name={PROFILE.name} links={NAV} activeHref={active} />
    <main id="main"><slot /></main>
    {bare ? null : (
      <SiteFooter headline={headline} email={PROFILE.email} socials={SOCIALS}>
        {footer === 'home' ? <p slot="note">Whether you’re improving a digital product, building a new website, or looking for someone who understands both design and frontend development, I’d be glad to hear about it.</p> : null}
        {footer === 'about' ? <p slot="note">I enjoy working with people who value thoughtful design, strong execution, and clear communication. If your project could benefit from that combination, let’s connect.</p> : null}
        {footer !== 'about' ? <div slot="actions" class="footer-actions"><Button variant="dark" href="/contact">{footer === 'home' ? 'Let’s Talk' : 'Get in Touch'}</Button></div> : null}
        <Fragment slot="legal"><span>© {year} Raveen Nanayakkara. All rights reserved.{PUBLIC_GA_MEASUREMENT_ID ? <button type="button" class="cookie-settings" data-consent-open hidden>Cookie settings</button> : null}</span><span>Thoughtful design. Practical development.</span></Fragment>
      </SiteFooter>
    )}
    {bare ? null : <ChatShortcut href={PROFILE.whatsapp} />}
    <ScrollProgress />
    <script>
      // Scroll reveal for every .reveal element.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
<style>
  .footer-actions { display: flex; justify-content: center; margin-top: 28px; }
  .cookie-settings { margin-left: 16px; padding: 0; border: none; background: none; font: inherit; color: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .cookie-settings:hover { color: var(--ink-900); }
</style>

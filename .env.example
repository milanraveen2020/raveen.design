# Copy to .env for local development, and add the same values in Vercel → Settings → Environment Variables.

# From resend.com → API Keys (starts with re_). Required for the contact form to send.
RESEND_API_KEY=

# Where enquiries are delivered. Defaults to milanraveen@gmail.com (the Resend account's email; the test
# sender can't deliver anywhere else). After verifying a domain you can use any address, e.g. rmnanayakkara@yahoo.com.
CONTACT_TO=milanraveen@gmail.com

# Sender address. onboarding@resend.dev only delivers to the email you signed up to Resend with.
# Once you verify your own domain in Resend, change this to e.g. Raveen.design <hello@yourdomain.com>.
CONTACT_FROM=Raveen.design <onboarding@resend.dev>
